actions.precombat=/snapshot_stats
actions.precombat+=/bear_form,if=buff.bear_form.down
actions.precombat+=/heart_of_the_wild
actions=/auto_attack
actions+=/call_action_list,name=cooldowns
actions+=/call_action_list,name=aoe,if=active_enemies>=3
actions+=/call_action_list,name=st
actions.aoe=/ironfur,if=!buff.ironfur.up|rage>=80
actions.aoe+=/moonfire,if=buff.galactic_guardian.up
actions.aoe+=/raze,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.aoe+=/maul,if=buff.ravage.up
actions.aoe+=/thrash
actions.aoe+=/moonfire,if=dot.moonfire.remains<=gcd&active_enemies<=6
actions.aoe+=/mangle
actions.aoe+=/maul,if=rage>=80
actions.aoe+=/swipe_bear
actions.cooldowns=/use_items
actions.cooldowns+=/potion,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.cooldowns+=/blood_fury,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.cooldowns+=/berserking,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.cooldowns+=/fireblood,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.cooldowns+=/ancestral_call,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.cooldowns+=/incarnation
actions.cooldowns+=/berserk
actions.cooldowns+=/convoke_the_spirits,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up|cooldown.berserk_bear.remains>30
actions.cooldowns+=/lunar_beam
actions.cooldowns+=/barkskin
actions.cooldowns+=/bristling_fur,if=rage<40
actions.st=/ironfur,if=!buff.ironfur.up|rage>=80
actions.st+=/moonfire,if=buff.galactic_guardian.up
actions.st+=/raze,if=buff.berserk_bear.up|buff.incarnation_guardian_of_ursoc.up
actions.st+=/maul,if=buff.ravage.up
actions.st+=/moonfire,if=dot.moonfire.remains<=gcd
actions.st+=/mangle
actions.st+=/thrash,if=dot.thrash.remains<=gcd|active_enemies>=1
actions.st+=/maul,if=rage>=80
actions.st+=/moonfire,if=buff.galactic_guardian.up
actions.st+=/swipe_bear