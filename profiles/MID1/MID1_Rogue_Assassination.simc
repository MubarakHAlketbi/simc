# Created 2026-03-16 — Assassination Rogue MID1 base profile
rogue="MID1_Rogue_Assassination"
source=default
spec=assassination
level=90
race=blood_elf
role=attack
position=back
# talents= (assassination talent hash not set — using defaults)

# Default consumables
potion=lights_potential_2
flask=flask_of_the_magisters_2
food=harandar_celebration
augmentation=void_touched
temporary_enchant=main_hand:thalassian_phoenix_oil_2/off_hand:thalassian_phoenix_oil_2

# This default action priority list is automatically created based on your character.
# It is a attempt to provide you with a action list that is both simple and practicable,
# while resulting in a meaningful and good simulation. It may not result in the absolutely highest possible dps.
# Feel free to edit, adapt and improve it to your own needs.
# SimulationCraft is always looking for updates and improvements to the default action lists.

# Executed before combat begins. Accepts non-harmful actions only.
actions.precombat=apply_poison
actions.precombat+=/snapshot_stats
actions.precombat+=/variable,name=trinket_sync_slot,value=1,if=trinket.1.has_use_buff&(!trinket.2.has_use_buff|trinket.1.cooldown.duration>=trinket.2.cooldown.duration)
actions.precombat+=/variable,name=trinket_sync_slot,value=2,if=trinket.2.has_use_buff&(!trinket.1.has_use_buff|trinket.2.cooldown.duration>trinket.1.cooldown.duration)
actions.precombat+=/stealth

# Executed every time the actor is available.
actions=variable,name=stealth,value=buff.stealth.up|buff.vanish.up|buff.subterfuge.up|buff.shadow_dance.up
actions+=/variable,name=targets,value=spell_targets.fan_of_knives
actions+=/variable,name=use_cds,value=buff.deathmark.up|cooldown.deathmark.remains<4|fight_remains<22
actions+=/call_action_list,name=race
actions+=/call_action_list,name=item
actions+=/call_action_list,name=cds
actions+=/call_action_list,name=dots
actions+=/call_action_list,name=finish,if=combo_points>=cp_max_spend
actions+=/call_action_list,name=build

actions.build=fan_of_knives,if=variable.targets>=4
actions.build+=/mutilate,if=variable.targets<4

actions.cds=potion,if=variable.use_cds
actions.cds+=/deathmark
actions.cds+=/vanish,if=!variable.stealth&combo_points<=1&cooldown.garrote.up
actions.cds+=/shadowmeld,if=!variable.stealth&combo_points<=1&cooldown.garrote.up

actions.dots=garrote,if=refreshable|(!talent.improved_garrote&!variable.stealth&buff.deathmark.up)
actions.dots+=/rupture,target_if=min:remains,if=combo_points>=4&refreshable
actions.dots+=/crimson_tempest,if=variable.targets>=4&combo_points>=4&refreshable

actions.finish=envenom
actions.finish+=/crimson_tempest,if=variable.targets>=4&refreshable

actions.item=use_item,name=algethar_puzzle_box,if=cooldown.deathmark.ready
actions.item+=/use_items,slots=trinket1,if=(variable.trinket_sync_slot=1&variable.use_cds|(variable.trinket_sync_slot=2&!trinket.2.cooldown.ready)|!variable.trinket_sync_slot)
actions.item+=/use_items,slots=trinket2,if=(variable.trinket_sync_slot=2&variable.use_cds|(variable.trinket_sync_slot=1&!trinket.1.cooldown.ready)|!variable.trinket_sync_slot)

actions.race=blood_fury,if=variable.use_cds
actions.race+=/berserking,if=variable.use_cds
actions.race+=/fireblood,if=variable.use_cds
actions.race+=/ancestral_call,if=variable.use_cds
actions.race+=/invoke_external_buff,name=power_infusion,if=variable.use_cds

head=masquerade_of_the_grim_jest,id=250006,bonus_id=12676/13338/13534/13575/13575/13575/13575/13575/13575/13575/13575/13575/13575,ilevel=289,gem_id=240983
