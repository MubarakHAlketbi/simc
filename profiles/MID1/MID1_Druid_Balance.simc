# Created 2026-03-16 — Balance Druid MID1 base profile
druid="MID1_Druid_Balance"
source=default
spec=balance
level=90
race=night_elf
timeofday=night
role=attack
position=ranged_back
talents=CcGAAAAAAAAAAAAAAAAAAAAAAAAAAAAAjZwMzMzMmtFPwyMbzYGzMDAAAALBzGMmZUzYWYmZGjZmZAAAAAAAGAAAABAz2MLNbzssBmZAWMDGAAzMAYA

# Default consumables
potion=lights_potential_2
flask=flask_of_the_magisters_2
food=blooming_feast
augmentation=void_touched
temporary_enchant=main_hand:thalassian_phoenix_oil_2

# This default action priority list is automatically created based on your character.
# It is a attempt to provide you with a action list that is both simple and practicable,
# while resulting in a meaningful and good simulation. It may not result in the absolutely highest possible dps.
# Feel free to edit, adapt and improve it to your own needs.
# SimulationCraft is always looking for updates and improvements to the default action lists.

# Executed before combat begins. Accepts non-harmful actions only.
# Snapshot raid buffed stats before combat begins and pre-potting is done.
actions.precombat=snapshot_stats
actions.precombat+=/moonkin_form
actions.precombat+=/wrath

# Executed every time the actor is available.
actions=potion,if=buff.ca_inc.up|fight_remains<32
actions+=/invoke_external_buff,name=power_infusion,if=buff.ca_inc.up
actions+=/berserking,if=buff.ca_inc.up
actions+=/blood_fury,if=buff.ca_inc.up
actions+=/ancestral_call,if=buff.ca_inc.up
actions+=/fireblood,if=buff.ca_inc.up
actions+=/use_item,slot=trinket1,if=buff.ca_inc.up
actions+=/use_item,slot=trinket2,if=buff.ca_inc.up
actions+=/celestial_alignment,if=!talent.incarnation_chosen_of_elune&(!talent.fury_of_elune|cooldown.fury_of_elune.remains<5)
actions+=/incarnation_chosen_of_elune,if=(!talent.fury_of_elune|cooldown.fury_of_elune.remains<5)
actions+=/fury_of_elune,if=eclipse.in_any&buff.ca_inc.up
actions+=/full_moon,if=buff.ca_inc.up|charges>1
actions+=/half_moon,if=buff.ca_inc.up|charges>1
actions+=/new_moon,if=buff.ca_inc.up|charges>1
actions+=/starfall,if=talent.starweaver&buff.starweaver_da.up&spell_targets>1
actions+=/starsurge,if=talent.starweaver&buff.starweaver_st.up
actions+=/sunfire,target_if=min:remains,if=refreshable&eclipse.in_any
actions+=/moonfire,target_if=min:remains,if=refreshable&eclipse.in_any
actions+=/stellar_flare,target_if=min:remains,if=talent.stellar_flare&refreshable
actions+=/starfall,if=buff.starlord.stack<3&spell_targets>1
actions+=/starsurge,if=buff.starlord.stack<3&spell_targets=1
actions+=/force_of_nature
actions+=/starfall,if=eclipse.in_lunar&spell_targets>1
actions+=/starsurge,if=eclipse.in_solar|eclipse.in_both
actions+=/starfall,if=spell_targets>1
actions+=/starsurge,if=buff.eclipse_solar.up|buff.eclipse_lunar.up
actions+=/sunfire,target_if=min:remains,if=refreshable
actions+=/moonfire,target_if=min:remains,if=refreshable
actions+=/wrath,if=eclipse.in_solar|eclipse.in_both|(eclipse.in_lunar&talent.umbral_embrace)
actions+=/starfire

