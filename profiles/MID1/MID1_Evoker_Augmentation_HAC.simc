# Created 2026-03-16 — Augmentation Evoker MID1 base profile
evoker="MID1_Evoker_Augmentation"
source=default
spec=augmentation
level=90
race=dracthyr_horde
role=attack
position=ranged_back
talents=CEcBAAAAAAAAAAAAAAAAAAAAAMmxMbzMzMWGYmtZMGmZDAAAAAGAAYmBGmZmaMzMDAAAAmxMYmxMzMwMbGDWglxwYbAMTEbYmBmZwgB

# Default consumables
potion=lights_potential_2
flask=flask_of_the_shattered_sun_2
food=silvermoon_parade
augmentation=void_touched
temporary_enchant=main_hand:thalassian_phoenix_oil_2

# This default action priority list is automatically created based on your character.
# It is a attempt to provide you with a action list that is both simple and practicable,
# while resulting in a meaningful and good simulation. It may not result in the absolutely highest possible dps.
# Feel free to edit, adapt and improve it to your own needs.
# SimulationCraft is always looking for updates and improvements to the default action lists.

# Executed before combat begins. Accepts non-harmful actions only.
# Snapshot raid buffed stats before combat begins and pre-potting is done.

# Executed every time the actor is available.
# Using C++ generator APL (apl_evoker.cpp augmentation()) — more sophisticated than the previous
# simplified Wowhead-derived APL. Key improvements: pandemic-based Ebon Might, cancel_buff
# tip_the_scales to avoid wasted fire_breath DoT with Molten Embers, fury_of_the_aspects,
# separate fb sub-list for empower-level selection, complex trinket sync with Breath of Eons.
# APL review 2026-03-22: replaced simplified profile APL with C++ generator output.

head=horns_of_the_spurned_valkyr,id=133506,bonus_id=12806/13577,gem_id=240906,enchant_id=7961
neck=ribbon_of_coiled_malice,id=249337,bonus_id=13355/13468/13469,gem_id=240906/240906
shoulders=beacons_of_the_black_talon,id=249995,bonus_id=13574,ilevel=289,enchant_id=8031
back=adherents_silken_shroud,id=239656,bonus_id=8960/12214/12214/12384/13622/13667/9627,crafted_stats=32/36
chest=frenzyward_of_the_black_talon,id=250000,bonus_id=13575,ilevel=289,enchant_id=7987
wrists=farstriders_plated_bracers,id=244584,bonus_id=1808/8960/12214/12214/12384/13622/13667/9627,gem_id=240906,crafted_stats=32/36
hands=enforcer_grips_of_the_black_talon,id=249998,bonus_id=13575,enchant_id=8013
