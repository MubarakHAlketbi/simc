finger2=eye_of_midnight,id=249920,ilevel=289,gem_id=240906/240906,enchant_id=7967
trinket1=shadow_of_the_empyrean_requiem,id=249810,bonus_id=13355/13468/13469
trinket2=heart_of_wind,id=250256,bonus_id=13355/13468/13469
main_hand=ceremonial_hexblade,id=251178,bonus_id=13355/13468/13469,enchant_id=8039
off_hand=grimoire_of_the_eternal_light,id=249276,ilevel=289

# Gear Summary
# gear_ilvl=288.50
# gear_stamina=17604
# gear_intellect=1670
